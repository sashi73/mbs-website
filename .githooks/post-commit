#!/bin/sh
# GKH Project Champ: tag every build (champ-b<N>) so any build can be checked out or restored.
# Push the tags from your own computer with:  git push --tags
ROOT=$(git rev-parse --show-toplevel)
B=$(node -e "console.log(JSON.parse(require('fs').readFileSync('$ROOT/champ-build.json','utf8')).build)" 2>/dev/null)
[ -n "$B" ] && git tag -f "champ-b$B" >/dev/null 2>&1
exit 0
