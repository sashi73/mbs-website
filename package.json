{
  "name": "gkh-project-champ",
  "version": "1.0.0",
  "private": true,
  "description": "GKH Project Champ: AI-powered project, program and portfolio management (from the MBS console)",
  "type": "module",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "start": "node --env-file=.env local-server.mjs",
    "check": "node --env-file=.env tools/check-setup.mjs",
    "jobs": "node tools/jobs.mjs",
    "prepare": "git config core.hooksPath .githooks || true",
    "build:bump": "node tools/build-bump.mjs"
  },
  "dependencies": {
    "@netlify/blobs": "11.1.3",
    "pdf-lib": "1.17.1",
    "qrcode": "1.5.4"
  }
}
