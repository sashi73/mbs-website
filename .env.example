# ==================================================================
#  MBS website: your private settings
#  Fill in the values after the = signs (no quotes, no spaces).
#  This file stays on your computer. Never email it or upload it.
# ==================================================================

# --- Local server ---
PORT=8888
# 127.0.0.1 = only this computer can open the site (safest)
HOST=127.0.0.1
ALLOWED_ORIGIN=http://localhost:8888

# --- DeepSeek AI (platform.deepseek.com > API keys) ---
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
# deepseek-chat = non-thinking mode (thinking is switched off)
LLM_MODEL=deepseek-chat
# Longest answer Mr. Fixit can give (500 max)
LLM_MAX_TOKENS=500

# --- Mr. Fixit's voice in other languages (optional) ---
# Azure Speech free tier (F0): portal.azure.com > Create "Speech service" > Keys and Endpoint.
# Copy KEY 1 and the Location/Region (e.g. australiaeast).
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=australiaeast
# Speaking speed for these voices (+0% = normal)
VOICE_RATE=+15%

# --- Telegram alerts to staff (REQUIRED) ---
# Token from @BotFather. Leave CHAT_ID empty, send your bot a message,
# then run the setup check: it will print the chat ID for you.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Email alerts to staff (REQUIRED, resend.com > API Keys) ---
RESEND_API_KEY=
# Until you verify your domain in Resend, OWNER_EMAIL must be the
# same email you signed up to Resend with.
# Temporary for testing. Switch to the business email once sending works.
OWNER_EMAIL=sashi1973@gmail.com
FROM_EMAIL=MBS Website <onboarding@resend.dev>

# --- Which alerts must succeed for an enquiry to count as sent ---
REQUIRED_CHANNELS=email,telegram

# --- Business details Mr. Fixit can share ---
PUBLIC_CONTACT_EMAIL=mbs.pty.ltd@gmail.com
SERVICE_AREA=Sydney and surrounding suburbs
BUSINESS_HOURS=Anytime (24 hours)

# --- Limits per visitor (stop abuse once the site is public) ---
# requests/minutes. Mr. Fixit chat, read-aloud voice, and sent enquiries.
LIMIT_CHAT=40/10
LIMIT_TTS=80/10
LIMIT_LEAD=8/60

# Where the team starts from: used for the distance, the Google Maps directions link and the QR code
# in every enquiry. Leave as is for Box Hill. (On Netlify you don't need to add these unless you change them.)
BASE_LOCATION=Box Hill NSW 2765
BASE_LAT=-33.6503
BASE_LNG=150.8647
